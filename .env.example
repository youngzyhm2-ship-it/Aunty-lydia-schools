# Copy to .env (or set these in your host's dashboard). All are optional.
PORT=3000
# Password for the first admin login. If empty, a random one is printed on first start.
ADMIN_PASSWORD=
# Set to 1 when the site is served over HTTPS (adds the Secure flag to the login cookie)
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway, Cloudflare...)
TRUST_PROXY=0
# Where the database and uploaded photos live. Back this folder up!
DATA_DIR=./data
# Optional: every new enquiry/application is POSTed here as JSON (Zapier, Make, n8n...)
NOTIFY_WEBHOOK_URL=
